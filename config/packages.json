        { "id": "Microsoft.Teams", "name": "Microsoft Teams", "enabled": true },
        { "id": "Microsoft.Outlook", "name": "Microsoft Outlook", "enabled": true },
        { "id": "Obsidian.Obsidian", "name": "Obsidian Note Taking", "enabled": false },
        { "id": "Discord.Discord", "name": "Discord", "enabled": false }
