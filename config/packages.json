{
  "$schema": "https://raw.githubusercontent.com/microsoft/winget-cli/master/schemas/JSON/packages/packages.schema.json",
  "description": "Curated list of Windows applications and CLI tools categorized by use-case.",
  "categories": {
    "core_tools": {
      "name": "Core System & CLI Utilities",
      "description": "Essential command-line tools and system enhancements",
      "packages": [
        { "id": "Git.Git", "name": "Git for Windows", "enabled": true },
        { "id": "GitHub.cli", "name": "GitHub CLI (gh)", "enabled": true },
        { "id": "Microsoft.PowerShell", "name": "PowerShell 7 (pwsh)", "enabled": true },
        { "id": "7zip.7zip", "name": "7-Zip Archive Manager", "enabled": true },
        { "id": "Microsoft.PowerToys", "name": "Microsoft PowerToys", "enabled": true },
        { "id": "Microsoft.WindowsTerminal", "name": "Windows Terminal", "enabled": true },
        { "id": "Starship.Starship", "name": "Starship Cross-Shell Prompt", "enabled": true }
      ]
    },
    "development": {
      "name": "Development & Runtimes",
      "description": "Programming languages, IDEs, and developer tools",
      "packages": [
        { "id": "Microsoft.VisualStudioCode", "name": "Visual Studio Code", "enabled": true },
        { "id": "Microsoft.WSL", "name": "Windows Subsystem for Linux (WSL2)", "enabled": true },
        { "id": "Python.Python.3.12", "name": "Python 3.12", "enabled": true },
        { "id": "OpenJS.NodeJS.LTS", "name": "Node.js (LTS)", "enabled": true },
        { "id": "Docker.DockerDesktop", "name": "Docker Desktop", "enabled": false }
      ]
    },
    "productivity_security": {
      "name": "Productivity & Security",
      "description": "Password management, notes, and cloud storage",
      "packages": [
        { "id": "DominikReichl.KeePass", "name": "KeePass Password Safe", "enabled": true },
        { "id": "Google.GoogleDrive", "name": "Google Drive", "enabled": true },
        { "id": "9NKSQGP7F2NH", "name": "WhatsApp", "enabled": true },
        { "id": "Microsoft.OneDrive", "name": "Microsoft OneDrive", "enabled": true },
        { "id": "Obsidian.Obsidian", "name": "Obsidian Note Taking", "enabled": false },
        { "id": "Discord.Discord", "name": "Discord", "enabled": false }
      ]
    },
    "creative_apps": {
      "name": "Creative & Audio/Video Production",
      "description": "DAWs, video editing, image editors, and audio hardware drivers",
      "packages": [
        {
          "name": "DaVinci Resolve",
          "id": "manual.davinci-resolve",
          "type": "manual_download",
          "url": "https://www.blackmagicdesign.com/products/davinciresolve",
          "checkPath": "C:\\Program Files\\Blackmagic Design\\DaVinci Resolve\\Resolve.exe",
          "enabled": true
        },
        {
          "name": "Kemper Rig Manager",
          "id": "manual.kemper-rig-manager",
          "type": "manual_download",
          "url": "https://www.kemper-amps.com/downloads",
          "checkPath": "C:\\Program Files\\Kemper Amps\\Rig Manager\\Rig Manager.exe",
          "enabled": true
        },
        {
          "name": "Teenage Engineering USB Audio Driver",
          "id": "manual.teenage-engineering-driver",
          "type": "manual_download",
          "url": "https://teenage.engineering/downloads",
          "checkPath": "C:\\Program Files\\teenage engineering\\USB audio device driver\\x64\\teusbaudioCpl.exe",
          "enabled": true
        },
        {
          "name": "Canon PIXMA MP190 Driver",
          "id": "manual.canon-pixma-mp190",
          "type": "manual_download",
          "url": "https://www.canon.fr/support/consumer_products/products/fax__multifunctionals/inkjet/pixma_mp_series/pixma_mp190.html",
          "checkPrinterDriver": "Canon MP190 series Printer",
          "enabled": true
        },
        {
          "name": "Gateway (Neural Amp Modeler Noise Gate)",
          "id": "manual.gateway-plugin",
          "type": "manual_download",
          "url": "https://www.neuralampmodeler.com/",
          "checkPath": "C:\\Program Files\\Gateway\\unins000.exe",
          "enabled": true
        },
        {
          "name": "ParametricOD (Neural Amp Modeler Overdrive)",
          "id": "manual.parametricod-plugin",
          "type": "manual_download",
          "url": "https://www.neuralampmodeler.com/",
          "checkPath": "C:\\Program Files\\ParametricOD\\unins000.exe",
          "enabled": true
        },
        { "id": "FocusriteAudioEngineeringLtd.FocusriteControl", "name": "Focusrite Control (Scarlett 6i6 2nd Gen)", "enabled": true },
        { "id": "GIMP.GIMP.3", "name": "GIMP 3 Image Editor", "enabled": true },
        { "id": "Cockos.REAPER", "name": "REAPER DAW (x64)", "enabled": true },
        { "id": "VideoLAN.VLC", "name": "VLC Media Player", "enabled": true },
        { "id": "Audacity.Audacity", "name": "Audacity Audio Editor", "enabled": false },
        { "id": "OBSProject.OBSStudio", "name": "OBS Studio", "enabled": false },
        { "id": "Spotify.Spotify", "name": "Spotify", "enabled": false }
      ]
    },
    "gaming_hardware": {
      "name": "Hardware Control & Gaming",
      "description": "Hardware control utilities and gaming platforms",
      "packages": [
        { "id": "seerge.g-helper", "name": "G-Helper (ASUS Control Tool)", "enabled": true },
        { "id": "Valve.Steam", "name": "Steam", "enabled": true }
      ]
    },
    "browsers": {
      "name": "Web Browsers",
      "description": "Modern browsers",
      "packages": [
        { "id": "Google.Chrome", "name": "Google Chrome", "enabled": true },
        { "id": "Mozilla.Firefox", "name": "Mozilla Firefox", "enabled": false },
        { "id": "Brave.Brave", "name": "Brave Browser", "enabled": false }
      ]
    }
  }
}
