{
  "$schema": "https://raw.githubusercontent.com/microsoft/winget-cli/master/schemas/JSON/packages/packages.schema.json",
  "description": "Curated list of Windows applications and CLI tools categorized by use-case.",
  "categories": {
    "core_tools": {
